# Deny-by-default. `*` ignores everything; each rule below names back exactly
# what ai-researcher ships. An unlisted file is invisible to git and can never
# be committed by accident — which is the point, because this working tree also
# holds pytest/benchmark caches, byte-compiled modules (scripts/diff_aa.py
# imports build.py, so running it writes __pycache__/) and scratch captures.
#
# The mechanic, because the pattern fails silently without it: git does not
# look inside a directory it has already ignored. So every kept directory is
# re-opened (`!dir/`), its contents denied again (`dir/*`), and its files are
# named back by a glob SCOPED to that directory. That scoping is what stops a
# `!*.py` from reaching into `__pycache__/`.
#
# Adding a file whose type is not already named back for its directory means
# adding a rule here. `git status` will NOT tell you the file is missing; it
# simply never appears. `git check-ignore -v <path>` names the rule hiding it.

*

# ---- repository root — the builder, the instruction files, the toolchain --
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.pylintrc
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/GOVERNANCE.md
!/LICENSE
!/README.md
!/SECURITY.md
!/build.py
!/page_format.py
!/pyrightconfig.json
!/requirements-dev.txt
!/requirements-pip-audit.txt
!/requirements-test.txt
!/requirements-zizmor.txt
!/setup.cfg

# ---- .github/ — CI workflows, dependabot, issue and PR templates ----------
!/.github/
/.github/*
!/.github/dependabot.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ci-thresholds.json
!/.github/perf-budgets.json
!/.github/instruction-budgets.json
!/.github/coverage-children.rc
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# ---- data/ — the captured AA artifact; never hand-edited -------------------
!/data/
/data/*
!/data/aa-raw-models.json
!/data/aa-raw-coding-agents.json
!/data/captured-at.txt
# The refresh's route-disagreement window stamp (issue #100): committed by
# the Capture step, retired when the routes agree again, so it is tracked,
# not junk.
!/data/aa-route-disagreement.txt

# ---- out/ — the published page --------------------------------------------
!/out/
/out/*
!/out/frontier-models.html

# ---- scripts/ — fetch and diff tooling -------------------------------------
!/scripts/
/scripts/*
!/scripts/*.py

# ---- scripts/ci/ — the coverage ratchet tooling ----------------------------
!/scripts/ci/
/scripts/ci/*
!/scripts/ci/*.py

# ---- tests/ ----------------------------------------------------------------
!/tests/
/tests/*
!/tests/*.py

# ---- tests/fixtures/ — the committed pipeline fixture -----------------------
# The fixed captures scripts/ci/instruction_budgets.py measures (issue #110):
# pinned bytes so the instruction budgets stay invariant to live-capture
# growth. Regenerated only via the generator in
# tests/test_ci_instruction_budgets.py, never hand-edited.
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/pipeline/
/tests/fixtures/pipeline/*
!/tests/fixtures/pipeline/aa-raw-models.json
!/tests/fixtures/pipeline/aa-raw-coding-agents.json
!/tests/fixtures/pipeline/captured-at.txt
